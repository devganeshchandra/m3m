# Copy to .env and fill in. Never commit the real .env file.

# --- Core ---
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://www.m3mindia.com,https://m3mindia.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Used for canonical links and the sitemap
SITE_URL=https://www.m3mindia.com

# --- HTTPS (production) ---
DJANGO_SECURE_SSL_REDIRECT=1
# Set to 31536000 only once the whole site is permanently on HTTPS
DJANGO_HSTS_SECONDS=0

# --- Database: PostgreSQL (see docs/DATABASE.md) ---
DB_ENGINE=postgres
DB_NAME=m3m
DB_USER=m3m
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# "require" when the database is on another server, e.g. a managed cloud database
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# --- Enquiry notifications ---
# Comma-separated addresses that receive an email for every new enquiry
LEAD_NOTIFICATION_EMAILS=
LEAD_RATE_LIMIT_PER_HOUR=20

# --- Email (SMTP) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=M3M India <no-reply@m3mindia.com>
